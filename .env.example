# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง — ห้าม commit .env
# สร้าง key ที่ https://platform.claude.com → API Keys (ตั้ง spend limit ด้วย)
ANTHROPIC_API_KEY=

# โมเดลที่ใช้ใน Node-RED และ Agent App
CLAUDE_MODEL=claude-opus-5-5

# (ทางเลือก) URL ของ n8n webhook ที่ Agent App ใช้ส่งแจ้งเตือน
# N8N_NOTIFY_URL=http://n8n:5678/webhook/notify

# (ทางเลือก) Lab 4 ต่อยอด: https URL จาก cloudflared tunnel สำหรับ Telegram Trigger
# WEBHOOK_URL=https://xxxx.trycloudflare.com/
